#!/usr/bin/env bash
# Git commit-msg hook — enforces the project's commit-message conventions.
#
# Install via scripts/git-hooks/install.sh.
#
# Rules:
# 1. Forbid AI/bot attribution trailers (CLAUDE.md project policy).
# 2. Append the canonical Authored-By trailer if missing.

set -e

MSG_FILE="$1"

# Rule 1: forbid AI attribution.
if grep -qiE "co-authored-by.*claude|generated with claude|co-authored-by.*anthropic" "$MSG_FILE"; then
    echo "ERROR: commit message contains AI/bot attribution." >&2
    echo "       Remove those trailers and commit again (CLAUDE.md policy)." >&2
    exit 1
fi

# Rule 2: append Authored-By trailer if missing.
if ! grep -qiE "^authored-by:" "$MSG_FILE"; then
    # Strip trailing blank lines, then append a blank line + trailer. Keeps
    # the message clean regardless of how git wrote the file (-m, -F, editor).
    trimmed=$(awk '/./{last=NR} {lines[NR]=$0} END {for(i=1;i<=last;i++) print lines[i]}' "$MSG_FILE")
    printf '%s\n\nAuthored-By: Emmanuel Powell-Clark <emmanuel@powellclark.com>\n' "$trimmed" > "$MSG_FILE"
fi
