[Unit]
Description=Voice to Text - Offline voice transcription
Documentation=https://github.com/powell-clark/voice-to-text
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vtt-linux
Restart=on-failure
RestartSec=5

# Environment - inherit from user session
PassEnvironment=DISPLAY XAUTHORITY WAYLAND_DISPLAY
Environment=PYTHONPATH=/usr/share/voice-to-text

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vtt

# Security hardening (user service compatible)
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
