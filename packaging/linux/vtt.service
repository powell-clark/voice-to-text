[Unit]
Description=Voice to Text - Offline voice transcription
Documentation=https://github.com/powell-clark/voice-to-text
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/vtt
Restart=always
RestartSec=5

# Coredump capture (TASK-VTT124) - a SEGV at the whisper/CUDA-Vulkan or ALSA
# FFI boundary is otherwise unrecoverable evidence. Requires systemd-coredump
# on the host; retrieve with `coredumpctl list vtt` / `coredumpctl debug`.
LimitCORE=infinity

# Environment - inherit from user session
PassEnvironment=DISPLAY XAUTHORITY WAYLAND_DISPLAY XDG_SESSION_TYPE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vtt

# Security hardening (user service compatible)
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
