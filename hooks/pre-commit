#!/usr/bin/env python3
"""Validate TSV format and cross-references before commit"""

import sys
import re
import subprocess
from pathlib import Path
from typing import Set, List, Tuple

def validate_tsv_file(file_path, schema):
    """Validate TSV file against schema"""
    errors = []

    if not file_path.exists():
        return errors  # File doesn't exist yet, skip

    with open(file_path) as f:
        lines = [line.strip() for line in f if line.strip() and not line.startswith('#')]

    if len(lines) < 1:
        return errors  # Empty file, skip

    # Validate header
    header = lines[0]
    expected_header = schema['header']
    if header != expected_header:
        errors.append(f"{file_path}: Invalid header. Expected: {expected_header}, Got: {header}")
        return errors  # Can't validate rows without correct header

    # Validate data rows
    expected_cols = len(expected_header.split('|'))
    for i, line in enumerate(lines[1:], start=2):
        cols = line.split('|')

        if len(cols) != expected_cols:
            errors.append(f"{file_path}:{i}: Expected {expected_cols} columns, got {len(cols)}")
            continue

        # Column-specific validation
        for col_idx, (col_name, validator) in enumerate(schema['columns'].items()):
            if col_idx < len(cols):
                col_value = cols[col_idx].strip()
                if not validator(col_value):
                    errors.append(f"{file_path}:{i}: Invalid {col_name}: '{col_value}'")

    return errors

# Schemas with validators
SCHEMAS = {
    'TASKS.md': {
        'header': 'id|story|status|title',
        'columns': {
            'id': lambda v: re.match(r'^TASK-(CC|JJ|NBL)\d{3}$', v),
            'story': lambda v: re.match(r'^(CC|JJ|NBL)\d{3}$', v),
            'status': lambda v: v in ['planned', 'in-progress', 'done', 'blocked', 'cancelled', 'duplicate'],
            'title': lambda v: len(v) > 0 and '|' not in v
        }
    },
    'STORY.md': {
        'header': 'id|epic|tasks|status|title',
        'columns': {
            'id': lambda v: re.match(r'^STORY-CC\d{3}$', v),
            'epic': lambda v: re.match(r'^CC\d{3}$', v),
            'tasks': lambda v: True,  # Can be empty or comma-separated numbers
            'status': lambda v: v in ['planned', 'in-progress', 'done', 'blocked', 'cancelled', 'duplicate'],
            'title': lambda v: len(v) > 0 and '|' not in v
        }
    },
    'EPICS.md': {
        'header': 'id|stories|category|priority|title',
        'columns': {
            'id': lambda v: re.match(r'^EPIC-CC\d{3}$', v),
            'stories': lambda v: True,  # Can be empty or comma-separated
            'category': lambda v: v in ['must-have', 'performance', 'delighter', 'nice-to-have'],
            'priority': lambda v: v in ['p0', 'p1', 'p2', 'p3', 'p4'],
            'title': lambda v: len(v) > 0 and '|' not in v
        }
    }
}


def parse_md_file(file_path: Path) -> List[dict]:
    """Parse pipe-delimited markdown file and return list of dicts"""
    if not file_path.exists():
        return []

    with open(file_path) as f:
        lines = f.readlines()

    if len(lines) < 3:
        return []

    header_line = None
    data_start = 0
    for i, line in enumerate(lines):
        if '|' in line and not line.strip().startswith('#'):
            header_line = line
            data_start = i + 1
            break

    if not header_line:
        return []

    headers = [h.strip() for h in header_line.strip().split('|')]

    rows = []
    for line in lines[data_start:]:
        line = line.strip()
        if not line or line.startswith('#'):
            continue

        values = [v.strip() for v in line.split('|')]
        if len(values) == len(headers):
            row = dict(zip(headers, values))
            rows.append(row)

    return rows


def extract_ids(value: str) -> Set[str]:
    """Extract comma-separated IDs from a value"""
    if not value or value == "none":
        return set()
    return {id.strip() for id in value.split(',') if id.strip()}


def validate_no_emoji(repo_root: Path) -> List[str]:
    """Validate that tracking files contain no emoji"""
    errors = []

    # Check all tracking files for emoji
    tracking_files = ['ROADMAP.md', 'EPICS.md', 'STORY.md', 'TASKS.md']

    for filename in tracking_files:
        filepath = repo_root / "CONSCIOUSNESS" / filename
        if not filepath.exists():
            continue

        with open(filepath, 'r', encoding='utf-8') as f:
            for line_num, line in enumerate(f, 1):
                # Detect emoji using Unicode ranges
                # Emoji are in various Unicode blocks
                emoji_pattern = re.compile(
                    "["
                    "\U0001F600-\U0001F64F"  # emoticons
                    "\U0001F300-\U0001F5FF"  # symbols & pictographs
                    "\U0001F680-\U0001F6FF"  # transport & map symbols
                    "\U0001F1E0-\U0001F1FF"  # flags
                    "\U00002702-\U000027B0"  # dingbats
                    "\U000024C2-\U0001F251"  # enclosed characters
                    "\U00002600-\U000026FF"  # misc symbols
                    "\U00002700-\U000027BF"  # dingbats
                    "\U0001F900-\U0001F9FF"  # supplemental symbols
                    "\U0001FA00-\U0001FA6F"  # extended symbols
                    "]+",
                    flags=re.UNICODE
                )

                if emoji_pattern.search(line):
                    errors.append(
                        f"{filename}:{line_num}: Contains emoji - FORBIDDEN\n"
                        f"         Line: {line.strip()}\n"
                        f"         → Fix: Remove all emoji characters (violates no-emoji rule in CLAUDE.md)"
                    )

    return errors


def validate_smart_criteria(repo_root: Path) -> List[str]:
    """Validate that epics and stories meet SMART criteria"""
    errors = []

    stories = parse_md_file(repo_root / "CONSCIOUSNESS" / "STORY.md")
    epics = parse_md_file(repo_root / "CONSCIOUSNESS" / "EPICS.md")

    # SMART indicators - must have at least one measurable element
    measurable_patterns = [
        r'\d+%',  # Percentages: 100%, 50%
        r'\d+ms',  # Milliseconds: 200ms, 500ms
        r'\d+s',   # Seconds: 60s, 2s
        r'\d+min', # Minutes: 6min
        r'<\d+',   # Less than: <200ms, <500ms
        r'>\d+',   # Greater than: >100
        r'\d+ to \d+',  # Ranges: 4 to 6, 10 to 20
        r'\d+-\d+',     # Ranges: 4-6, 10-20
        r'within \d+',  # Within X: within 200ms
        r'under \d+',   # Under X: under 2 seconds
        r'every \d+',   # Frequency: every 60 seconds
        r'per \d+',     # Rate: per minute
        r'\d+\+',       # At least: 10+, 100+
        r'\d+ (files?|tests?|hooks?|sessions?|stories?|tasks?|reflections?|subdirs?|columns?)',  # Countables
    ]

    # Check stories (skip done/cancelled)
    for story in stories:
        story_id = story.get('id', 'UNKNOWN')
        status = story.get('status', '')
        title = story.get('title', '')

        if status in ['done', 'cancelled', 'duplicate']:
            continue

        # Check for measurable criteria
        has_measurable = any(re.search(pattern, title, re.IGNORECASE) for pattern in measurable_patterns)

        if not has_measurable:
            errors.append(
                f"STORY.md: {story_id} lacks measurable success criteria (not SMART)\n"
                f"         Title: {title}\n"
                f"         → Fix: Add specific numbers/metrics (e.g., '<200ms', '4-6 sessions', '100% coverage')"
            )

    # Check epics
    for epic in epics:
        epic_id = epic.get('id', 'UNKNOWN')
        title = epic.get('title', '')

        # Check for measurable criteria
        has_measurable = any(re.search(pattern, title, re.IGNORECASE) for pattern in measurable_patterns)

        if not has_measurable:
            errors.append(
                f"EPICS.md: {epic_id} lacks measurable success criteria (not SMART)\n"
                f"         Title: {title}\n"
                f"         → Fix: Add specific metrics/deliverables (e.g., '<100ms execution', '14 skills documented')"
            )

    return errors


def validate_cross_references(repo_root: Path) -> List[str]:
    """Validate cross-references between TASKS.md, STORY.md, and EPICS.md"""
    errors = []

    tasks = parse_md_file(repo_root / "CONSCIOUSNESS" / "TASKS.md")
    stories = parse_md_file(repo_root / "CONSCIOUSNESS" / "STORY.md")
    epics = parse_md_file(repo_root / "CONSCIOUSNESS" / "EPICS.md")

    # Build ID sets
    story_ids = {story['id'] for story in stories if 'id' in story}
    epic_ids = {epic['id'] for epic in epics if 'id' in epic}
    task_ids = {task['id'] for task in tasks if 'id' in task}

    # Validate task → story references
    for task in tasks:
        task_id = task.get('id', 'UNKNOWN')
        story_ref = task.get('story', '')

        if story_ref and story_ref != "none":
            story_id = f"STORY-{story_ref}" if not story_ref.startswith('STORY-') else story_ref
            if story_id not in story_ids:
                errors.append(
                    f"TASKS.md: {task_id} references non-existent story {story_id}\n"
                    f"         → Fix: Create {story_id} in STORY.md or update task to reference existing story"
                )

    # Validate story → epic references
    for story in stories:
        story_id = story.get('id', 'UNKNOWN')
        epic_ref = story.get('epic', '')

        if epic_ref and epic_ref != "none":
            epic_id = f"EPIC-{epic_ref}" if not epic_ref.startswith('EPIC-') else epic_ref
            if epic_id not in epic_ids:
                errors.append(
                    f"STORY.md: {story_id} references non-existent epic {epic_id}\n"
                    f"         → Fix: Create {epic_id} in EPICS.md or update story to reference existing epic"
                )

    # Validate story → task references
    for story in stories:
        story_id = story.get('id', 'UNKNOWN')
        task_refs = story.get('tasks', '')

        if task_refs and task_refs != "none":
            task_list = extract_ids(task_refs)
            for task_ref in task_list:
                task_id = f"TASK-{task_ref}" if not task_ref.startswith('TASK-') else task_ref
                if task_id not in task_ids:
                    errors.append(
                        f"STORY.md: {story_id} references non-existent task {task_id}\n"
                        f"         → Fix: Create {task_id} in TASKS.md or remove {task_ref} from tasks list"
                    )

    # Validate epic → story references
    for epic in epics:
        epic_id = epic.get('id', 'UNKNOWN')
        story_refs = epic.get('stories', '')

        if story_refs and story_refs != "none":
            story_list = extract_ids(story_refs)
            for story_ref in story_list:
                story_id = f"STORY-{story_ref}" if not story_ref.startswith('STORY-') else story_ref
                if story_id not in story_ids:
                    errors.append(
                        f"EPICS.md: {epic_id} references non-existent story {story_id}\n"
                        f"         → Fix: Create {story_id} in STORY.md or remove {story_ref} from stories list"
                    )

    return errors


def validate_commit_message():
    """Check commit message doesn't contain Anthropic attribution"""
    import subprocess

    # Get the commit message from the staging area
    try:
        result = subprocess.run(
            ['git', 'log', '--format=%B', '-n', '1', 'HEAD'],
            capture_output=True,
            text=True,
            timeout=5
        )
        commit_msg = result.stdout
    except:
        # If we can't get HEAD (initial commit), skip this check
        return []

    errors = []

    # Check for forbidden attribution (actual attribution lines, not just mentions)
    if '🤖 Generated with [Claude Code]' in commit_msg:
        errors.append("Commit message contains Claude Code attribution - FORBIDDEN")

    if re.search(r'^Co-Authored-By: Claude <', commit_msg, re.MULTILINE):
        errors.append("Commit message contains 'Co-Authored-By: Claude' - FORBIDDEN")

    if 'noreply@anthropic.com' in commit_msg:
        errors.append("Commit message contains Anthropic email - FORBIDDEN")

    return errors

def main():
    """Run validation on TSV files, cross-references, and commit message in repo"""
    all_errors = []

    repo_root = Path(__file__).parent.parent.parent  # .git/hooks/pre-commit -> repo root

    # Validate TSV files
    for filename, schema in SCHEMAS.items():
        file_path = repo_root / filename
        if file_path.exists():
            errors = validate_tsv_file(file_path, schema)
            all_errors.extend(errors)

    # Validate no emoji in tracking files
    emoji_errors = validate_no_emoji(repo_root)
    all_errors.extend(emoji_errors)

    # Validate SMART criteria
    smart_errors = validate_smart_criteria(repo_root)
    all_errors.extend(smart_errors)

    # Validate cross-references
    xref_errors = validate_cross_references(repo_root)
    all_errors.extend(xref_errors)

    # Validate commit message
    commit_errors = validate_commit_message()
    all_errors.extend(commit_errors)

    if all_errors:
        print("\n❌ Pre-commit Validation Errors:", file=sys.stderr)
        for error in all_errors:
            print(f"   {error}", file=sys.stderr)

        if any('TSV' in e or '.md:' in e for e in all_errors):
            print("\nFix format/reference errors in tracking files.", file=sys.stderr)
        if commit_errors:
            print("\nCommit message cannot contain Anthropic/Claude Code attribution.", file=sys.stderr)
            print("See CLAUDE.md for commit format specification.\n", file=sys.stderr)
        sys.exit(1)

    print("✅ Pre-commit validation passed", file=sys.stderr)
    sys.exit(0)

if __name__ == '__main__':
    main()
