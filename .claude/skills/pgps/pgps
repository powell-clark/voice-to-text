    # Extract in-progress tasks (lines starting with "- " but not None, DONE, completed, or warnings)
    IN_PROGRESS=$(grep -E "^- [^✅⚠️N\[]" CONSCIOUSNESS/TODO.md 2>/dev/null | grep -v "^- None" | grep -v "\[DONE\]" | head -5)
