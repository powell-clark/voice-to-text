#!/usr/bin/env bash

# Project-Only GPS - Shows only project-specific sections without master/cross-project data
# Usage: project-gps or pgps
#
# Uses unified schema from precepts/schema.json via utils/schema.sh

# Source schema helper if available
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UTILS_DIR="$SCRIPT_DIR/../../utils"

if [ -f "$UTILS_DIR/schema.sh" ]; then
    source "$UTILS_DIR/schema.sh"
    SCHEMA_AVAILABLE=true
else
    SCHEMA_AVAILABLE=false
fi

# Truncate string to max length with ellipsis
truncate() {
    local str="$1"
    local max="${2:-80}"
    if [ ${#str} -gt $max ]; then
        echo "${str:0:$((max-3))}..."
    else
        echo "$str"
    fi
}

# Validation helper: check_file FILE FILENAME
# Uses schema.sh if available, otherwise uses hardcoded values
# Returns: 0=valid, 1=file missing, 2=file corrupted
check_file() {
    local file="$1"
    local filename="$2"

    if [ "$SCHEMA_AVAILABLE" = true ]; then
        check_file_schema "$file" "$filename"
        return $?
    fi

    # Fallback: get expected values based on filename
    local expected_header=""
    local expected_cols=""
    case "$filename" in
        "EPICS.md"|"EPIC-BACKLOG.md"|"EPIC-DONE.md")
            expected_header="id|quarter|stories|category|priority|title|completion|created|started|expected_end|actual_end"
            expected_cols=11
            ;;
        "STORY.md"|"STORY-BACKLOG.md"|"STORY-DONE.md")
            expected_header="id|epic|tasks|status|title"
            expected_cols=5
            ;;
        "TASKS.md"|"TASK-BACKLOG.md"|"TASK-DONE.md")
            expected_header="id|story|status|title"
            expected_cols=4
            ;;
        "FEATURES.md"|"FEATURES-BACKLOG.md"|"FEATURES-DONE.md")
            expected_header="id|status|location|tested|description"
            expected_cols=5
            ;;
        *)
            return 0  # Unknown file, assume valid
            ;;
    esac

    if [ ! -f "$file" ]; then
        return 1  # missing
    fi

    # Get header (first non-comment, non-empty line with pipes)
    local header=$(grep -v '^#' "$file" | grep -v '^$' | grep '|' | head -1)

    if [ -z "$header" ]; then
        return 2  # corrupted (no header)
    fi

    # Check header matches
    if [ "$header" != "$expected_header" ]; then
        return 2  # corrupted (wrong header)
    fi

    # Check data rows have correct column count (if any exist)
    local data_lines=$(grep -v '^#' "$file" | grep -v '^$' | grep '|' | tail -n +2)
    if [ -n "$data_lines" ]; then
        local first_row=$(echo "$data_lines" | head -1)
        local col_count=$(echo "$first_row" | tr -cd '|' | wc -c)
        col_count=$((col_count + 1))

        if [ "$col_count" -ne "$expected_cols" ]; then
            return 2  # corrupted (wrong column count)
        fi
    fi

    return 0  # valid
}

# Get display message for file state
# Uses schema.sh if available, otherwise uses hardcoded messages
get_file_message() {
    local filename="$1"
    local msg_type="$2"  # empty, missing, corrupted

    if [ "$SCHEMA_AVAILABLE" = true ]; then
        get_message "$filename" "$msg_type"
        return
    fi

    # Fallback messages
    case "$msg_type" in
        "empty")
            case "$filename" in
                "EPICS.md") echo "[empty - file valid, no epics defined]" ;;
                "EPIC-BACKLOG.md") echo "[empty - file valid, no backlog epics]" ;;
                "EPIC-DONE.md") echo "[empty - file valid, no completed epics]" ;;
                "STORY.md") echo "[empty - file valid, no stories defined]" ;;
                "STORY-BACKLOG.md"|"STORY-DONE.md") echo "[no entries]" ;;
                "TASKS.md") echo "[no entries]" ;;
                "TASK-BACKLOG.md"|"TASK-DONE.md") echo "[no entries]" ;;
                "FEATURES.md"|"FEATURES-BACKLOG.md"|"FEATURES-DONE.md") echo "[no entries]" ;;
                *) echo "[empty]" ;;
            esac
            ;;
        "missing")
            case "$filename" in
                "EPICS.md"|"STORY.md"|"TASKS.md"|"FEATURES.md")
                    echo "[file missing - run: neurologist --fix]"
                    ;;
                *)
                    echo "[file missing - optional]"
                    ;;
            esac
            ;;
        "corrupted")
            echo "[file corrupted - check $filename header]"
            ;;
    esac
}

