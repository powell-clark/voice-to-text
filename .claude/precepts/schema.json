{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.1",
  "updated": "2025-11-27",
  "description": "Canonical schema for CONSCIOUSNESS tracking files - backlog files have no status column per ADR-0030",

  "statuses": {
    "work": ["planned", "in-progress", "in-review", "blocked", "done", "cancelled", "duplicate"],
    "features": ["planned", "implementing", "implemented", "deprecated"]
  },

  "categories": ["must-have", "should-have", "nice-to-have", "performance", "delighter", "future"],

  "priorities": ["p0", "p1", "p2", "p3", "p4"],

  "files": {
    "EPICS.md": {
      "path": "CONSCIOUSNESS/epics/EPICS.md",
      "header": "id|quarter|stories|category|priority|title|completion|created|started|expected_end|actual_end",
      "columns": 11,
      "required": true,
      "id_prefix": "EPIC",
      "empty_message": "[empty - file valid, no epics defined]",
      "missing_message": "[file missing - run: neurologist --fix]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "EPIC-BACKLOG.md": {
      "path": "CONSCIOUSNESS/epics/EPIC-BACKLOG.md",
      "header": "id|quarter|stories|category|priority|title|completion|created|started|expected_end|actual_end",
      "columns": 11,
      "required": false,
      "id_prefix": "EPIC",
      "empty_message": "[empty - file valid, no backlog epics]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "EPIC-DONE.md": {
      "path": "CONSCIOUSNESS/epics/EPIC-DONE.md",
      "header": "id|quarter|stories|category|priority|title|completion|created|started|expected_end|actual_end",
      "columns": 11,
      "required": false,
      "id_prefix": "EPIC",
      "empty_message": "[empty - file valid, no completed epics]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "STORY.md": {
      "path": "CONSCIOUSNESS/stories/STORY.md",
      "header": "id|epic|tasks|status|title",
      "columns": 5,
      "required": true,
      "id_prefix": "STORY",
      "empty_message": "[empty - file valid, no stories defined]",
      "missing_message": "[file missing - run: neurologist --fix]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "STORY-BACKLOG.md": {
      "path": "CONSCIOUSNESS/stories/STORY-BACKLOG.md",
      "header": "id|epic|tasks|title",
      "columns": 4,
      "required": false,
      "id_prefix": "STORY",
      "empty_message": "[empty - file valid, no backlog stories]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "STORY-DONE.md": {
      "path": "CONSCIOUSNESS/stories/STORY-DONE.md",
      "header": "id|epic|tasks|status|title",
      "columns": 5,
      "required": false,
      "id_prefix": "STORY",
      "empty_message": "[empty - file valid, no completed stories]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "TASKS.md": {
      "path": "CONSCIOUSNESS/tasks/TASKS.md",
      "header": "id|story|status|title",
      "columns": 4,
      "required": true,
      "id_prefix": "TASK",
      "empty_message": "[empty - file valid, no tasks defined]",
      "missing_message": "[file missing - run: neurologist --fix]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "TASK-BACKLOG.md": {
      "path": "CONSCIOUSNESS/tasks/TASK-BACKLOG.md",
      "header": "id|story|title",
      "columns": 3,
      "required": false,
      "id_prefix": "TASK",
      "empty_message": "[empty - file valid, no backlog tasks]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "TASK-DONE.md": {
      "path": "CONSCIOUSNESS/tasks/TASK-DONE.md",
      "header": "id|story|status|title",
      "columns": 4,
      "required": false,
      "id_prefix": "TASK",
      "empty_message": "[empty - file valid, no completed tasks]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "FEATURES.md": {
      "path": "CONSCIOUSNESS/features/FEATURES.md",
      "header": "id|status|location|tested|description",
      "columns": 5,
      "required": true,
      "id_prefix": "FEAT",
      "empty_message": "[empty - file valid, no features defined]",
      "missing_message": "[file missing - run: neurologist --fix]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "FEATURES-BACKLOG.md": {
      "path": "CONSCIOUSNESS/features/FEATURES-BACKLOG.md",
      "header": "id|location|tested|description",
      "columns": 4,
      "required": false,
      "id_prefix": "FEAT",
      "empty_message": "[empty - file valid, no backlog features]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "FEATURES-DONE.md": {
      "path": "CONSCIOUSNESS/features/FEATURES-DONE.md",
      "header": "id|status|location|tested|description",
      "columns": 5,
      "required": false,
      "id_prefix": "FEAT",
      "empty_message": "[empty - file valid, no completed features]",
      "missing_message": "[file missing - optional]",
      "corrupted_message": "[file corrupted - check header]"
    },
    "TODO.md": {
      "path": "CONSCIOUSNESS/TODO.md",
      "header": null,
      "columns": null,
      "required": true,
      "id_prefix": null,
      "empty_message": "[no active todos]",
      "missing_message": "[file missing]",
      "corrupted_message": null
    }
  },

  "templates": {
    "EPICS.md": "# Epics\n\nid|quarter|stories|category|priority|title|completion|created|started|expected_end|actual_end",
    "EPIC-BACKLOG.md": "# Epics - Backlog\n\nid|quarter|stories|category|priority|title|completion|created|started|expected_end|actual_end",
    "EPIC-DONE.md": "# Epics - Done\n\nid|quarter|stories|category|priority|title|completion|created|started|expected_end|actual_end",
    "STORY.md": "# Stories\n\nid|epic|tasks|status|title",
    "STORY-BACKLOG.md": "# Stories - Backlog\n\nid|epic|tasks|title",
    "STORY-DONE.md": "# Stories - Done\n\nid|epic|tasks|status|title",
    "TASKS.md": "# Tasks\n\nid|story|status|title",
    "TASK-BACKLOG.md": "# Tasks - Backlog\n\nid|story|title",
    "TASK-DONE.md": "# Tasks - Done\n\nid|story|status|title",
    "FEATURES.md": "# Features\n\nid|status|location|tested|description",
    "FEATURES-BACKLOG.md": "# Features - Backlog\n\nid|location|tested|description",
    "FEATURES-DONE.md": "# Features - Done\n\nid|status|location|tested|description",
    "TODO.md": "# TODO\n\nNo tasks yet."
  },

  "validation": {
    "smart_patterns": [
      "\\d+%",
      "\\d+ms",
      "\\d+s",
      "<\\d+",
      ">\\d+",
      "\\d+-\\d+",
      "\\d+ to \\d+",
      "within \\d+",
      "under \\d+",
      "every \\d+",
      "per \\d+",
      "\\d+\\+",
      "\\d+ (files?|tests?|hooks?|sessions?|stories?|tasks?)"
    ],
    "trajectory": {
      "in_progress_story_requires_tasks": true,
      "in_progress_story_requires_in_progress_task": true
    },
    "forbidden_commit_patterns": [
      "Generated with \\[Claude Code\\]",
      "Co-Authored-By: Claude",
      "noreply@anthropic.com"
    ]
  },

  "pgps": {
    "sections": [
      "EPICS",
      "EPICS.DONE",
      "EPICS.BACKLOG",
      "STORY",
      "STORY.DONE",
      "STORY.BACKLOG",
      "TASKS",
      "TASKS.DONE",
      "TASKS.BACKLOG",
      "TODO",
      "FEATURES",
      "FEATURES.DONE",
      "FEATURES.BACKLOG",
      "GIT",
      "CURRENT"
    ],
    "status_display_order": ["in-review", "in-progress", "planned", "blocked"]
  }
}
