#!/usr/bin/make -f

# voice-to-text 2.0.2+ — pre-built binary distribution.
#
# Ubuntu Noble LTS ships cargo 1.75, which cannot parse edition 2024
# Cargo.toml manifests that modern Rust dependencies (getrandom 0.3,
# moxcms, pxfm, toml_edit etc. via cpal/arboard) now use. Building from
# source on Launchpad's Noble builders is therefore structurally broken
# without bundling a newer Rust toolchain, which adds its own brittleness.
#
# Pragmatic solution: Emmanuel builds the release binary locally with
# rustup (currently Rust 1.91), commits it to the source tree as
# packaging/linux/vtt.prebuilt, and Launchpad's "build" step is
# simply to install that binary. Google Chrome, Zoom, and many proprietary
# .debs use this exact pattern. dh_shlibdeps still runs against the
# installed libraries to generate correct Depends.
#
# When Ubuntu eventually ships a Rust toolchain that can parse edition
# 2024 (expected in 25.04+), this file can be reverted to the cargo-build
# path at git history commit efa5d75.

%:
	dh $@

override_dh_auto_build:
	# Verify the pre-built binary is present and executable.
	test -x packaging/linux/vtt.prebuilt || (echo "ERROR: packaging/linux/vtt.prebuilt missing. \
Run 'cargo build --release' locally and 'cp target/release/vtt packaging/linux/vtt.prebuilt'." && exit 1)
	# Sanity: confirm it's an ELF x86_64 Linux binary.
	file packaging/linux/vtt.prebuilt | grep -q "ELF 64-bit LSB.*x86-64" || \
		(echo "ERROR: packaging/linux/vtt.prebuilt is not a valid x86_64 ELF." && exit 1)

override_dh_auto_install:
	install -D -m 0755 packaging/linux/vtt.prebuilt \
		debian/voice-to-text/usr/bin/vtt
	# Compatibility symlink (TASK-VTT102). The binary was /usr/bin/vtt-linux in
	# every release up to 2.4.0, so it is in users' shell history, scripts and
	# muscle memory. Renaming without this would break all of that on upgrade
	# for no user-facing benefit — the name was only ever confusing on Windows
	# and macOS, which never saw this path. Drop the symlink only on a release
	# that deliberately accepts that break.
	ln -sf vtt debian/voice-to-text/usr/bin/vtt-linux
	install -D -m 0644 packaging/linux/vtt.service \
		debian/voice-to-text/usr/lib/systemd/user/vtt.service
	install -D -m 0644 debian/voice-to-text.desktop \
		debian/voice-to-text/usr/share/applications/voice-to-text.desktop
	install -d debian/voice-to-text/usr/share/voice-to-text/models
	# Optional CT2 daemon backend (TASK-VTT167, FEAT-VTT034). Ships the script
	# so resolve_daemon_script() can find it on a real install, not just a dev
	# checkout -- but never pulls in faster-whisper/ctranslate2 here, since the
	# default backend is native whisper-rs and this package promises no Python
	# is required. A user who opts into backend=ct2 installs the daemon's own
	# Python deps manually: `pip install -r
	# /usr/share/voice-to-text/ct2-daemon/requirements.txt`.
	install -D -m 0644 ct2-daemon/transcribe_daemon.py \
		debian/voice-to-text/usr/share/voice-to-text/ct2-daemon/transcribe_daemon.py
	install -D -m 0644 ct2-daemon/requirements.txt \
		debian/voice-to-text/usr/share/voice-to-text/ct2-daemon/requirements.txt

override_dh_auto_clean:
	# No cargo state to clean — binary is committed.
	true

override_dh_clean:
	dh_clean -Xvendor -Xpackaging/linux/vtt.prebuilt

override_dh_auto_test:
	@echo "Tests deferred to STORY-VTT014 (GitHub Actions matrix build)"

# Disable stripping — the binary is already stripped by cargo, and
# running strip on a vendored binary can cause reproducibility issues.
override_dh_strip:
	dh_strip --no-automatic-dbgsym
