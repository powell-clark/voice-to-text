#!/usr/bin/make -f

# Debian rules file for voice-to-text
# See debhelper(7) (uncomment to enable)

# Output every command that modifies files on the build system
#export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	# Build using the Linux Makefile
	$(MAKE) -f Makefile.linux

override_dh_auto_install:
	# Install binary
	install -D -m 0755 vtt-linux debian/voice-to-text/usr/bin/vtt-linux

	# Install source files for Python backend
	install -D -m 0755 src/common/transcribe.py debian/voice-to-text/usr/share/voice-to-text/transcribe.py

	# Install systemd user service
	install -D -m 0644 vtt.service debian/voice-to-text/usr/lib/systemd/user/vtt.service

	# Install desktop entry
	install -D -m 0644 debian/voice-to-text.desktop debian/voice-to-text/usr/share/applications/voice-to-text.desktop

override_dh_auto_clean:
	# Clean build artifacts
	$(MAKE) -f Makefile.linux clean || true
	rm -f vtt-linux
	rm -rf build/

override_dh_auto_test:
	# Skip tests for now (add unit tests later)
	@echo "Skipping tests"
