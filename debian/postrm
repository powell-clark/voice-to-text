#!/bin/bash
set -e

# postrm script for voice-to-text

case "$1" in
    purge)
        # Remove the system-wide model that postinst downloaded (~488 MB).
        # dpkg does not track it (postinst created it at runtime), so without
        # this it would be orphaned on disk after purge.
        echo "Purging voice-to-text..."
        rm -rf /usr/share/voice-to-text/models
        rmdir /usr/share/voice-to-text 2>/dev/null || true
        echo ""
        echo "Per-user data is not removed automatically (it lives under your \$HOME):"
        echo "  rm -rf ~/.local/share/voice-to-text  # settings, logs, recordings"
        echo "  rm -rf ~/.cache/voice-to-text/models # downloaded GGML models"
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Reload systemd daemon to remove the service
        echo "Cleaning up systemd configuration..."

        # Note: Users need to run this themselves
        if [ "$1" = "remove" ]; then
            echo "To clean up systemd, run:"
            echo "  systemctl --user daemon-reload"
        fi
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
