#!/bin/bash
set -e

# postinst script for voice-to-text

case "$1" in
    configure)
        echo "Installing dependencies for voice-to-text..."

        # Install faster-whisper and ctranslate2 for transcription
        # Use --break-system-packages for Python 3.12+
        if ! python3 -m pip list 2>/dev/null | grep -q faster-whisper; then
            echo "Installing Python transcription backend..."
            python3 -m pip install --break-system-packages faster-whisper ctranslate2 || {
                echo "Warning: Failed to install Python packages. You may need to install manually:"
                echo "  python3 -m pip install --break-system-packages faster-whisper ctranslate2"
            }
        else
            echo "faster-whisper is already installed"
        fi

        # Install whisper.cpp for W model support
        if ! command -v whisper-cli >/dev/null 2>&1; then
            echo "Installing whisper.cpp for whisper.cpp model support..."
            WHISPER_DIR="/opt/whisper.cpp"

            if [ ! -d "$WHISPER_DIR" ]; then
                echo "Downloading whisper.cpp..."
                git clone https://github.com/ggerganov/whisper.cpp "$WHISPER_DIR" || {
                    echo "Warning: Failed to download whisper.cpp"
                    echo "You can install manually: sudo git clone https://github.com/ggerganov/whisper.cpp /opt/whisper.cpp"
                }
            fi

            if [ -d "$WHISPER_DIR" ]; then
                echo "Building whisper.cpp (this may take a few minutes)..."
                cd "$WHISPER_DIR" && make -j$(nproc) && {
                    ln -sf "$WHISPER_DIR/main" /usr/local/bin/whisper-cli
                    echo "whisper-cli installed successfully"
                } || {
                    echo "Warning: Failed to build whisper.cpp"
                    echo "You can build manually: cd /opt/whisper.cpp && sudo make"
                }
            fi
        else
            echo "whisper-cli is already installed"
        fi

        # Enable and start the service for logged-in desktop users
        echo "Enabling voice-to-text service..."

        # Find users with active graphical sessions and enable/start the service for them
        started_for_users=""
        if command -v loginctl >/dev/null 2>&1; then
            for session in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
                session_type=$(loginctl show-session "$session" -p Type --value 2>/dev/null)
                if [ "$session_type" = "x11" ] || [ "$session_type" = "wayland" ]; then
                    user=$(loginctl show-session "$session" -p Name --value 2>/dev/null)
                    uid=$(id -u "$user" 2>/dev/null)
                    if [ -n "$user" ] && [ -n "$uid" ] && [ "$uid" -ge 1000 ]; then
                        export XDG_RUNTIME_DIR="/run/user/$uid"
                        if runuser -l "$user" -c "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user daemon-reload" 2>/dev/null; then
                            runuser -l "$user" -c "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user enable vtt.service" 2>/dev/null
                            runuser -l "$user" -c "XDG_RUNTIME_DIR=/run/user/$uid systemctl --user start vtt.service" 2>/dev/null
                            started_for_users="$started_for_users $user"
                        fi
                    fi
                fi
            done
        fi

        echo ""
        echo "============================================"
        echo "Voice to Text installed!"
        echo "============================================"
        echo ""
        if [ -n "$started_for_users" ]; then
            echo "✓ Service started for:$started_for_users"
            echo ""
            echo "Hold Scroll Lock and speak - text appears where you type."
            echo ""
        else
            echo "Log out and back in, or run:"
            echo "  systemctl --user enable --now vtt"
            echo ""
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
