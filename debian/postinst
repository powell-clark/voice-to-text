#!/bin/sh
# Post-install script for voice-to-text.
# Downloads the default small.en GGML model if not already present so that
# the first run works offline. Also enables the user systemd service for
# any logged-in graphical user.

set -e

MODEL_DIR=/usr/share/voice-to-text/models
MODEL_FILE="$MODEL_DIR/ggml-small.en.bin"
MODEL_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.en.bin"
# Expected SHA-256 of the upstream ggml-small.en.bin (stable released artefact).
MODEL_SHA256="c6138d6d58ecc8322097e0f987c32f1be8bb0a18532a3f88f734d1bbf9c41e5d"

case "$1" in
    configure)
        mkdir -p "$MODEL_DIR"
        if [ ! -f "$MODEL_FILE" ]; then
            echo "voice-to-text: downloading default Whisper model (ggml-small.en.bin, ~488 MB)..."
            if curl --fail --silent --show-error -L --max-time 600 \
                    -o "$MODEL_FILE.tmp" "$MODEL_URL"; then
                # Verify integrity before promoting — a truncated or corrupted
                # download must never become the real model path.
                ACTUAL_SHA=$(sha256sum "$MODEL_FILE.tmp" 2>/dev/null | cut -d' ' -f1)
                if [ "$ACTUAL_SHA" = "$MODEL_SHA256" ]; then
                    mv "$MODEL_FILE.tmp" "$MODEL_FILE"
                    echo "voice-to-text: default model installed at $MODEL_FILE (sha256 verified)"
                else
                    rm -f "$MODEL_FILE.tmp"
                    echo "voice-to-text: model checksum mismatch (expected $MODEL_SHA256, got ${ACTUAL_SHA:-none}); discarded. Use the tray menu to retry later."
                fi
            else
                rm -f "$MODEL_FILE.tmp"
                echo "voice-to-text: model download failed (offline?). Use the tray menu to retry later."
            fi
        fi

        # Enable the user systemd service for any logged-in graphical users.
        # On fresh install: daemon-reload + enable + start.
        # On upgrade ($2 is the previous version): also try-restart so the
        # new binary actually takes effect — plain 'start' is a no-op if
        # the service is already running, which would leave users on the
        # old binary in memory until they reboot.
        IS_UPGRADE=""
        [ -n "$2" ] && IS_UPGRADE="yes"

        if command -v loginctl >/dev/null 2>&1; then
            for session in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
                session_type=$(loginctl show-session "$session" -p Type --value 2>/dev/null)
                if [ "$session_type" = "x11" ] || [ "$session_type" = "wayland" ]; then
                    user=$(loginctl show-session "$session" -p Name --value 2>/dev/null)
                    uid=$(id -u "$user" 2>/dev/null)
                    if [ -n "$user" ] && [ -n "$uid" ] && [ "$uid" -ge 1000 ]; then
                        XDG="XDG_RUNTIME_DIR=/run/user/$uid"
                        runuser -l "$user" -c "$XDG systemctl --user daemon-reload" 2>/dev/null || true
                        runuser -l "$user" -c "$XDG systemctl --user enable vtt.service" 2>/dev/null || true
                        if [ -n "$IS_UPGRADE" ]; then
                            # try-restart: restarts if running, no-op if stopped
                            runuser -l "$user" -c "$XDG systemctl --user try-restart vtt.service" 2>/dev/null || true
                            # Also start in case the service was never running
                            # (e.g. user disabled auto-start on previous install)
                            runuser -l "$user" -c "$XDG systemctl --user start vtt.service" 2>/dev/null || true
                        else
                            runuser -l "$user" -c "$XDG systemctl --user start vtt.service" 2>/dev/null || true
                        fi
                    fi
                fi
            done
        fi

        # Read the actual installed version — never hardcode.
        INSTALLED_VERSION=$(dpkg-query --show --showformat='${Version}' voice-to-text 2>/dev/null || echo "installed")
        echo ""
        echo "============================================"
        echo "Voice to Text ${INSTALLED_VERSION} installed"
        echo "============================================"
        echo "Hold Scroll Lock and speak — text appears where you type."
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
