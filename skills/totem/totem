#!/bin/bash
# Consciousness Installation Validator (Totem)
# Validates consciousness tracking system installation in current repository
# Exit codes: 0=all valid, 1=validation failed, 2=not installed

# Colour codes
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'
BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

ERRORS=0; WARNINGS=0; PASS=0

# Header
echo -e "${BOLD}${CYAN}Consciousness Installation Validator${NC}\n"

# Check 1: CONSCIOUSNESS directory exists
if [ ! -d "CONSCIOUSNESS" ]; then
    echo -e "${RED}✗${NC} CONSCIOUSNESS directory not found - consciousness not installed"
    exit 2
fi
echo -e "${GREEN}✓${NC} CONSCIOUSNESS directory exists"
((PASS++))

# Check 2: Required subdirectories
REQUIRED_DIRS=("roadmap" "epics" "stories" "tasks")
for dir in "${REQUIRED_DIRS[@]}"; do
    if [ ! -d "CONSCIOUSNESS/$dir" ]; then
        echo -e "${RED}✗${NC} Missing subdirectory: CONSCIOUSNESS/$dir/"
        ((ERRORS++))
    else
        echo -e "${GREEN}✓${NC} Subdirectory exists: CONSCIOUSNESS/$dir/"
        ((PASS++))
    fi
done

# Check 3: Required tracking files
REQUIRED_FILES=(
    "CONSCIOUSNESS/roadmap/ROADMAP.md"
    "CONSCIOUSNESS/roadmap/ROADMAP-BACKLOG.md"
    "CONSCIOUSNESS/roadmap/ROADMAP-DONE.md"
    "CONSCIOUSNESS/epics/EPICS.md"
    "CONSCIOUSNESS/epics/EPIC-BACKLOG.md"
    "CONSCIOUSNESS/epics/EPIC-DONE.md"
    "CONSCIOUSNESS/stories/STORY.md"
    "CONSCIOUSNESS/stories/STORY-BACKLOG.md"
    "CONSCIOUSNESS/stories/STORY-DONE.md"
    "CONSCIOUSNESS/tasks/TASKS.md"
    "CONSCIOUSNESS/tasks/TASK-BACKLOG.md"
    "CONSCIOUSNESS/tasks/TASK-DONE.md"
    "CONSCIOUSNESS/TODO.md"
    "CONSCIOUSNESS/HUMAN-TIME-LOG.md"
    "CONSCIOUSNESS/AGENT-TIME-LOG.md"
)

for file in "${REQUIRED_FILES[@]}"; do
    if [ ! -f "$file" ]; then
        echo -e "${RED}✗${NC} Missing file: $file"
        ((ERRORS++))
    elif [ ! -s "$file" ]; then
        echo -e "${YELLOW}⚠${NC} File present but empty: $file"
        ((WARNINGS++))
        ((PASS++))
    else
        # Check format: ROADMAP/STORY-BACKLOG use brackets, EPIC-BACKLOG/TASK-BACKLOG use pipes, others use pipes
        if [[ "$file" =~ ROADMAP ]] || [[ "$file" =~ STORY-BACKLOG\.md$ ]]; then
            if grep -q "\[" "$file"; then
                echo -e "${GREEN}✓${NC} File valid: $file"
                ((PASS++))
            else
                echo -e "${RED}✗${NC} File corrupted (no bracket format): $file"
                ((ERRORS++))
            fi
        elif [[ "$file" =~ TODO\.md$ ]]; then
            # TODO.md uses markdown list format, not pipes
            if grep -qE "^- \[" "$file" || grep -q "IN_PROGRESS\|DONE\|PENDING" "$file"; then
                echo -e "${GREEN}✓${NC} File valid: $file"
                ((PASS++))
            else
                echo -e "${YELLOW}⚠${NC} File present (no entries): $file"
                ((WARNINGS++))
                ((PASS++))
            fi
        else
            # EPICS/STORY/TASKS/TIME-LOG use pipe-delimited format
            if grep -q "|" "$file"; then
                echo -e "${GREEN}✓${NC} File valid: $file"
                ((PASS++))
            else
                echo -e "${RED}✗${NC} File corrupted (no TSV format): $file"
                ((ERRORS++))
            fi
        fi
    fi
done

# Check 4: Hook installation
HOOK_DIR=".claude/hooks"
if [ ! -d "$HOOK_DIR" ]; then
    echo -e "${YELLOW}⚠${NC} .claude/hooks directory not found"
    ((WARNINGS++))
else
    REQUIRED_HOOKS=(
        "sync-todo.py"
        "update-time-log.py"
        "track-activity-context.py"
    )
    for hook in "${REQUIRED_HOOKS[@]}"; do
        if [ ! -f "$HOOK_DIR/$hook" ]; then
            echo -e "${YELLOW}⚠${NC} Hook not installed: $hook"
            ((WARNINGS++))
        elif [ ! -x "$HOOK_DIR/$hook" ]; then
            echo -e "${YELLOW}⚠${NC} Hook not executable: $hook"
            ((WARNINGS++))
        else
            echo -e "${GREEN}✓${NC} Hook installed: $hook"
            ((PASS++))
        fi
    done
fi

# Check 5: CLAUDE.md compliance
if [ ! -f "CLAUDE.md" ]; then
    echo -e "${YELLOW}⚠${NC} CLAUDE.md not found"
    ((WARNINGS++))
else
    # Check for consciousness preamble
    if grep -q "## Consciousness System" CLAUDE.md; then
        echo -e "${GREEN}✓${NC} CLAUDE.md has consciousness preamble"
        ((PASS++))
    else
        echo -e "${YELLOW}⚠${NC} CLAUDE.md missing consciousness preamble"
        ((WARNINGS++))
    fi

    # Check for required sections
    REQUIRED_SECTIONS=("TodoWrite" "Time Tracking")
    MISSING_SECTIONS=()
    for section in "${REQUIRED_SECTIONS[@]}"; do
        if ! grep -qi "$section" CLAUDE.md; then
            MISSING_SECTIONS+=("$section")
        fi
    done
    if [ ${#MISSING_SECTIONS[@]} -eq 0 ]; then
        echo -e "${GREEN}✓${NC} CLAUDE.md contains required sections"
        ((PASS++))
    else
        echo -e "${YELLOW}⚠${NC} CLAUDE.md missing sections: ${MISSING_SECTIONS[*]}"
        ((WARNINGS++))
    fi
fi

# Check 6: GPS command works
if command -v ~/.claude/skills/pgps/pgps &> /dev/null; then
    if ~/.claude/skills/pgps/pgps > /dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} GPS command (pgps) works"
        ((PASS++))
    else
        echo -e "${RED}✗${NC} GPS command (pgps) fails"
        ((ERRORS++))
    fi
else
    echo -e "${YELLOW}⚠${NC} GPS command (pgps) not found"
    ((WARNINGS++))
fi

# Check 7: Time log command works
if command -v ~/.claude/skills/time-log/show-pretty.sh &> /dev/null; then
    if ~/.claude/skills/time-log/show-pretty.sh h 1 > /dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} Time log command (l2h) works"
        ((PASS++))
    else
        echo -e "${RED}✗${NC} Time log command (l2h) fails"
        ((ERRORS++))
    fi
else
    echo -e "${YELLOW}⚠${NC} Time log command (l2h) not found"
    ((WARNINGS++))
fi

# Check 8: Remove legacy files
LEGACY_FILES=(
    "GPS.md"
    "ROADMAP-OLD.md"
    "MASTER-ROADMAP.md"
    "TODO-MASTER.md"
)
FOUND_LEGACY=()
for legacy in "${LEGACY_FILES[@]}"; do
    if [ -f "$legacy" ] || [ -f "CONSCIOUSNESS/$legacy" ]; then
        FOUND_LEGACY+=("$legacy")
    fi
done
if [ ${#FOUND_LEGACY[@]} -eq 0 ]; then
    echo -e "${GREEN}✓${NC} No legacy files found"
    ((PASS++))
else
    echo -e "${YELLOW}⚠${NC} Legacy files found (should remove): ${FOUND_LEGACY[*]}"
    ((WARNINGS++))
fi

# Check 9: ADR directory exists
if [ ! -d "CONSCIOUSNESS/adr" ]; then
    echo -e "${RED}✗${NC} CONSCIOUSNESS/adr/ directory not found"
    ((ERRORS++))
else
    echo -e "${GREEN}✓${NC} ADR directory exists"
    ((PASS++))

    # Check for ADR-0000 initial file
    if [ -f "CONSCIOUSNESS/adr/0000-use-architecture-decision-records.md" ]; then
        echo -e "${GREEN}✓${NC} ADR-0000 initial record present"
        ((PASS++))
    else
        echo -e "${RED}✗${NC} ADR-0000 missing (no initial ADR record)"
        ((ERRORS++))
    fi
fi

# Check 10: Cross-reference validation (only in consciousness repo)
if [ -f "scripts/validate-cross-references.py" ]; then
    echo -e "\n${BOLD}Cross-Reference Validation:${NC}"
    if python3 scripts/validate-cross-references.py > /dev/null 2>&1; then
        echo -e "${GREEN}✓${NC} All task→story→epic references valid"
        ((PASS++))
    else
        echo -e "${RED}✗${NC} Cross-reference validation failed"
        ((ERRORS++))
    fi
fi

# Summary
echo -e "\n${BOLD}Summary:${NC}"
echo -e "${GREEN}Passed:${NC} $PASS"
[ $WARNINGS -gt 0 ] && echo -e "${YELLOW}Warnings:${NC} $WARNINGS"
[ $ERRORS -gt 0 ] && echo -e "${RED}Errors:${NC} $ERRORS"

# Exit code
if [ $ERRORS -gt 0 ]; then
    echo -e "\n${RED}${BOLD}Installation INVALID${NC}"
    exit 1
elif [ $WARNINGS -gt 0 ]; then
    echo -e "\n${YELLOW}${BOLD}Installation VALID (with warnings)${NC}"
    exit 0
else
    echo -e "\n${GREEN}${BOLD}Installation VALID${NC}"
    exit 0
fi
