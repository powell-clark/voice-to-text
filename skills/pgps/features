#!/usr/bin/env bash
# Display features list from CONSCIOUSNESS/FEATURES.md

echo "Features | $(date '+%Y-%m-%d %H:%M:%S %Z') | $(basename $PWD)"
echo ""

if [ -f CONSCIOUSNESS/FEATURES.md ]; then
    echo "FEATURES.PROJECT:"
    echo "  [in_progress]=Active [in_review]=Testing"
    echo ""
    tail -n +4 CONSCIOUSNESS/FEATURES.md 2>/dev/null | grep -E "in_review|in_progress" | while IFS='|' read -r id status location tested description; do
        if [ -n "$id" ]; then
            echo "  [$id] [$status] $description"
        fi
    done
else
    echo "  [CONSCIOUSNESS/FEATURES.md not found]"
fi
echo ""

# Done features
if [ -f CONSCIOUSNESS/FEATURES-DONE.md ]; then
    echo "FEATURES.DONE.PROJECT:"
    tail -n +4 CONSCIOUSNESS/FEATURES-DONE.md 2>/dev/null | head -10 | while IFS='|' read -r id status location tested description; do
        if [ -n "$id" ]; then
            echo "  [$id] $description"
        fi
    done
else
    echo "  [no completed features yet]"
fi
echo ""

# Backlog
echo ""
if [ -f CONSCIOUSNESS/FEATURES-BACKLOG.md ]; then
    echo "FEATURES.BACKLOG.PROJECT:"
    tail -n +5 CONSCIOUSNESS/FEATURES-BACKLOG.md 2>/dev/null | head -10 | while IFS='|' read -r id status location tested description; do
        if [ -n "$id" ]; then
            echo "  [$id] [$status] $description"
        fi
    done
else
    echo "  [no backlog features yet]"
fi
