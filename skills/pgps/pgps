#!/usr/bin/env bash

# Project-Only GPS - Shows only project-specific sections without master/cross-project data
# Usage: project-gps or pgps

# Validation helper: check_file FILE EXPECTED_HEADER EXPECTED_COLS
# Returns: 0=valid, 1=file missing, 2=file corrupted
check_file() {
    local file="$1"
    local expected_header="$2"
    local expected_cols="$3"

    if [ ! -f "$file" ]; then
        return 1  # missing
    fi

    # Get header (first non-comment, non-empty line with pipes)
    local header=$(grep -v '^#' "$file" | grep -v '^$' | grep '|' | head -1)

    if [ -z "$header" ]; then
        return 2  # corrupted (no header)
    fi

    # Check header matches
    if [ "$header" != "$expected_header" ]; then
        return 2  # corrupted (wrong header)
    fi

    # Check data rows have correct column count (if any exist)
    local data_lines=$(grep -v '^#' "$file" | grep -v '^$' | grep '|' | tail -n +2)
    if [ -n "$data_lines" ]; then
        local first_row=$(echo "$data_lines" | head -1)
        local col_count=$(echo "$first_row" | tr -cd '|' | wc -c)
        col_count=$((col_count + 1))

        if [ "$col_count" -ne "$expected_cols" ]; then
            return 2  # corrupted (wrong column count)
        fi
    fi

    return 0  # valid
}

# Print header with timestamp and location
echo "Project GPS | $(date '+%Y-%m-%d %H:%M:%S %Z') | $(basename $(pwd)) | $(git branch --show-current 2>/dev/null || echo 'no-git')"
echo ""

# KEY at top per Emmanuel's feedback
echo "KEY:"
echo "  Priority: [P0]=Critical [P1]=Must-have [P2]=Should-have [P3]=Nice-to-have [P4]=Future"
echo "  Status: [TODO]=Planned [IN_PROGRESS]=Active [BLOCKED]=Waiting [DONE]=Complete"
echo "  Tags: @session-id +date-added !deadline"
echo ""

# SESSION
echo "SESSION: $(basename $(pwd))-$(git branch --show-current 2>/dev/null || echo 'main')-$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')"
echo ""

# ROADMAP.PROJECT
echo "ROADMAP.PROJECT:"
check_file "CONSCIOUSNESS/roadmap/ROADMAP.md" "quarter|epic_id|priority|category|title|completion" 6
case $? in
    0)
        CONTENT=$(tail -n +4 CONSCIOUSNESS/roadmap/ROADMAP.md 2>/dev/null | grep -E "^Q[0-9]" | head -7)
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS= read -r line; do echo "  $line"; done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# EPICS.PROJECT
echo "EPICS.PROJECT:"
check_file "CONSCIOUSNESS/epics/EPICS.md" "id|stories|category|priority|title" 5
case $? in
    0)
        CONTENT=$(tail -n +4 CONSCIOUSNESS/epics/EPICS.md 2>/dev/null | head -7)
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS='|' read -r id stories category priority title; do
            echo "  [$id] [stories: $stories] [$category] [$priority] $title"
        done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# EPICS.BACKLOG.PROJECT (future quarter epics from ROADMAP)
echo "EPICS.BACKLOG.PROJECT:"
if [ -f CONSCIOUSNESS/roadmap/ROADMAP.md ]; then
    CONTENT=$(tail -n +4 CONSCIOUSNESS/roadmap/ROADMAP.md 2>/dev/null | grep -E "^Q[1-4]-202[6-9]" | head -10)
    [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS= read -r line; do echo "  $line"; done
else
    echo "  [file missing]"
fi
echo ""

# STORY.PROJECT
echo "STORY.PROJECT:"
check_file "CONSCIOUSNESS/stories/STORY.md" "id|epic|tasks|status|title" 5
case $? in
    0)
        SESSION_SHORT=$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')
        CONTENT=$(tail -n +4 CONSCIOUSNESS/stories/STORY.md 2>/dev/null | grep -E "in-progress|in_progress|done" | head -5)
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS='|' read -r id epic tasks status title; do
            echo "  [$id] [epic: $epic] [tasks: $tasks] [$status] $title @$SESSION_SHORT"
        done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# STORY.BACKLOG.PROJECT
echo "STORY.BACKLOG.PROJECT:"
check_file "CONSCIOUSNESS/stories/STORY-BACKLOG.md" "id|epic|tasks|status|title" 5
case $? in
    0)
        CONTENT=$(tail -n +4 CONSCIOUSNESS/stories/STORY-BACKLOG.md 2>/dev/null | head -5)
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS='|' read -r id epic tasks status title; do
            echo "  [$id] [epic: $epic] [$status] $title"
        done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# TASKS.PROJECT
echo "TASKS.PROJECT:"
check_file "CONSCIOUSNESS/tasks/TASKS.md" "id|story|status|title" 4
case $? in
    0)
        CONTENT=$(tail -n +4 CONSCIOUSNESS/tasks/TASKS.md 2>/dev/null | grep -E "in-progress|in_progress" | head -5)
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS='|' read -r id story status title; do
            echo "  [$id] [story: $story] [$status] $title"
        done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# GIT STATUS
echo "GIT:"
if [ -d .git ]; then
    BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
    CHANGES=$(git status --porcelain 2>/dev/null | wc -l)
    AHEAD=$(git rev-list --count @{u}..HEAD 2>/dev/null || echo "0")
    BEHIND=$(git rev-list --count HEAD..@{u} 2>/dev/null || echo "0")
    COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "no-commit")
    echo "  branch:$BRANCH changes:$CHANGES ahead:$AHEAD behind:$BEHIND @$COMMIT"
else
    echo "  [not a git repository]"
fi
echo ""

# FEATURES.PROJECT
echo "FEATURES.PROJECT:"
check_file "CONSCIOUSNESS/features/FEATURES.md" "id|status|location|tested|description" 5
case $? in
    0)
        CONTENT=$(grep -E "^FT-[0-9]+" CONSCIOUSNESS/features/FEATURES.md 2>/dev/null | grep -v "^id|")
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS='|' read -r id status location tested description; do
            echo "  [$id] [$status] [$location] [tested:$tested] $description"
        done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# FEATURES DONE
echo "FEATURES.DONE:"
check_file "CONSCIOUSNESS/features/FEATURES-DONE.md" "id|status|location|tested|description" 5
case $? in
    0)
        CONTENT=$(grep -E "^FT-[0-9]+\|done\|" CONSCIOUSNESS/features/FEATURES-DONE.md 2>/dev/null | head -5)
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS='|' read -r id status location tested description; do
            echo "  [$id] [$location] [tested:$tested] $description"
        done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# FEATURES BACKLOG
echo "FEATURES.BACKLOG:"
check_file "CONSCIOUSNESS/features/FEATURES-BACKLOG.md" "id|status|location|tested|description" 5
case $? in
    0)
        CONTENT=$(grep -E "^FT-[0-9]+" CONSCIOUSNESS/features/FEATURES-BACKLOG.md 2>/dev/null | grep -v "^id|" | head -10)
        [ -n "$CONTENT" ] && echo "$CONTENT" | while IFS='|' read -r id status location tested description; do
            echo "  [$id] [$status] [$location] [tested:$tested] $description"
        done
        ;;
    1) echo "  [file missing]" ;;
    2) echo "  [file corrupted]" ;;
esac
echo ""

# CURRENT TASK
echo "CURRENT:"
if [ -f CONSCIOUSNESS/tasks/TASKS.md ]; then
    CURRENT=$(tail -n +4 CONSCIOUSNESS/tasks/TASKS.md 2>/dev/null | grep -E "in-progress|in_progress" | head -1)
    [ -n "$CURRENT" ] && echo "$CURRENT" | while IFS='|' read -r id story status title; do
        echo "  [$id] $title"
    done
else
    echo "  [file missing]"
fi

exit 0
